# =====================================================
# HarbourRWA — .gitignore
# =====================================================

# --- Excluded directories per requirement ---
document/
techdocument/
test/
app/test/

# --- Non-code text/doc files at root ---
tmpline.txt
*.txt
*.srt

# --- Node.js / Next.js ---
node_modules/
.next/
out/
dist/
build/
!app/src/app/api/**/build/
!app/src/app/api/**/build/**

# --- Solidity / Hardhat ---
app/contracts/cache/
app/contracts/artifacts/
app/contracts/typechain-types/

# --- Environment & secrets ---
.env
.env.local
.env.*.local
.env.development
.env.production

# --- Casper generated keys / downloaded artifacts ---
/casper-keys/
app/casper-keys/
app/casper-artifacts/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
.eggs/

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE ---
.idea/
*.suo
*.user

# --- Misc build / cache ---
.cache/
coverage/
.turbo/

# --- Root-level utility scripts (not part of app code) ---
/*.py
/*.ps1
/*.js
/*.mjs
/*.png
/*.md
!/README.md

# --- Rust build artifacts ---
app/contracts-casper/target/*
!app/contracts-casper/target/wasm32-unknown-unknown/
app/contracts-casper/target/wasm32-unknown-unknown/*
!app/contracts-casper/target/wasm32-unknown-unknown/release/
app/contracts-casper/target/wasm32-unknown-unknown/release/*
!app/contracts-casper/target/wasm32-unknown-unknown/release/token_coupon_build_contract.min.wasm
!app/contracts-casper/target/wasm32-unknown-unknown/release/identity_registry_build_contract.nobulk.wasm
app/contracts-casper/.cargo/
app/contracts-casper/Cargo.lock

# --- Scratch / debug files ---
app/src/lib/casper-token-deploy.ts.orig
app/test-deploy-server.cjs
